<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" 
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" 
           xsi:type="TaskPaneApp">

  <Id>e4c1b4c3-56d1-48cc-bf96-040278cf5aee</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Kanosym</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Kanosym"/>
  <Description DefaultValue="Hybrid financial reasoning tools inside Excel"/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.kanosym.com/help"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>https://localhost:5001</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" 
                    xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <!-- Custom Kanosym Tab -->
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="KanosymTab">
              <!-- AI Tools Group -->
              <Group id="AIToolsGroup">
                <Label resid="AIToolsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <!-- Open Noira Task Pane -->
                <Control xsi:type="Button" id="NoiraTaskpaneButton">
                  <Label resid="NoiraTaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="NoiraTaskpaneButton.Label"/>
                    <Description resid="NoiraTaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>NoiraPane</TaskpaneId>
                    <SourceLocation resid="NoiraTaskpane.Url"/>
                  </Action>
                </Control>

                <!-- Analytics Panel -->
                <Control xsi:type="Button" id="AnalyticsTaskpaneButton">
                  <Label resid="AnalyticsTaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="AnalyticsTaskpaneButton.Label"/>
                    <Description resid="AnalyticsTaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>AnalyticsPane</TaskpaneId>
                    <SourceLocation resid="AnalyticsTaskpane.Url"/>
                  </Action>
                </Control>
              </Group>

              <!-- Data Import Group -->
              <Group id="DataImportGroup">
                <Label resid="DataImportGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <!-- Import Portfolio Data -->
                <!-- <Control xsi:type="Button" id="ImportPortfolioButton">
                  <Label resid="ImportPortfolioButton.Label"/>
                  <Supertip>
                    <Title resid="ImportPortfolioButton.Label"/>
                    <Description resid="ImportPortfolioButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>importPortfolioData</FunctionName>
                  </Action>
                </Control> -->

                <!-- Get Data from Salesforce -->
                <Control xsi:type="Button" id="SalesforceButton">
                  <Label resid="SalesforceButton.Label"/>
                  <Supertip>
                    <Title resid="SalesforceButton.Label"/>
                    <Description resid="SalesforceButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>getDataFromSalesforce</FunctionName>
                  </Action>
                </Control>

                <!-- Load Historical Prices -->
                <Control xsi:type="Button" id="HistoricalPricesButton">
                  <Label resid="HistoricalPricesButton.Label"/>
                  <Supertip>
                    <Title resid="HistoricalPricesButton.Label"/>
                    <Description resid="HistoricalPricesButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>loadHistoricalPrices</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Analysis Group -->
              <Group id="AnalysisGroup">
                <Label resid="AnalysisGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <!-- Run Classical Test -->
                <Control xsi:type="Button" id="ClassicalTestButton">
                  <Label resid="ClassicalTestButton.Label"/>
                  <Supertip>
                    <Title resid="ClassicalTestButton.Label"/>
                    <Description resid="ClassicalTestButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>runClassicalTest</FunctionName>
                  </Action>
                </Control>

                <!-- Run Hybrid Test -->
                <Control xsi:type="Button" id="HybridTestButton">
                  <Label resid="HybridTestButton.Label"/>
                  <Supertip>
                    <Title resid="HybridTestButton.Label"/>
                    <Description resid="HybridTestButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>runHybridTest</FunctionName>
                  </Action>
                </Control>

                <!-- Run Quantum Test -->
                <Control xsi:type="Button" id="QuantumTestButton">
                  <Label resid="QuantumTestButton.Label"/>
                  <Supertip>
                    <Title resid="QuantumTestButton.Label"/>
                    <Description resid="QuantumTestButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>runQuantumTest</FunctionName>
                  </Action>
                </Control>

                <!-- Compare Methods -->
                <Control xsi:type="Button" id="CompareMethodsButton">
                  <Label resid="CompareMethodsButton.Label"/>
                  <Supertip>
                    <Title resid="CompareMethodsButton.Label"/>
                    <Description resid="CompareMethodsButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>compareAnalysisMethods</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Results Group -->
              <Group id="ResultsGroup">
                <Label resid="ResultsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <!-- Export Results -->
                <Control xsi:type="Button" id="ExportResultsButton">
                  <Label resid="ExportResultsButton.Label"/>
                  <Supertip>
                    <Title resid="ExportResultsButton.Label"/>
                    <Description resid="ExportResultsButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>exportResults</FunctionName>
                  </Action>
                </Control>

                <!-- Generate Report -->
                <Control xsi:type="Button" id="GenerateReportButton">
                  <Label resid="GenerateReportButton.Label"/>
                  <Supertip>
                    <Title resid="GenerateReportButton.Label"/>
                    <Description resid="GenerateReportButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>generateReport</FunctionName>
                  </Action>
                </Control>

                <!-- Functions Help -->
                <Control xsi:type="Button" id="FunctionsHelpButton">
                  <Label resid="FunctionsHelpButton.Label"/>
                  <Supertip>
                    <Title resid="FunctionsHelpButton.Label"/>
                    <Description resid="FunctionsHelpButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>showFunctionsHelp</FunctionName>
                  </Action>
                </Control>
              </Group>
              <Label resid="KanosymTab.Label"/>
            </CustomTab>
          </ExtensionPoint>

          <!-- Link to commands.js -->
          <FunctionFile resid="Commands.Url"/>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
        <bt:Url id="NoiraTaskpane.Url" DefaultValue="https://localhost:3000/noira.html"/>
        <bt:Url id="AnalyticsTaskpane.Url" DefaultValue="https://localhost:3000/analytics.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="KanosymTab.Label" DefaultValue="Kanosym"/>
        <bt:String id="AIToolsGroup.Label" DefaultValue="AI Tools"/>
        <bt:String id="DataImportGroup.Label" DefaultValue="Data Import"/>
        <bt:String id="AnalysisGroup.Label" DefaultValue="Analysis"/>
        <bt:String id="ResultsGroup.Label" DefaultValue="Results"/>
        <bt:String id="NoiraTaskpaneButton.Label" DefaultValue="Open Noira"/>
        <bt:String id="AnalyticsTaskpaneButton.Label" DefaultValue="Analytics"/>
        <bt:String id="ImportPortfolioButton.Label" DefaultValue="Import Portfolio"/>
        <bt:String id="SalesforceButton.Label" DefaultValue="Salesforce Data"/>
        <bt:String id="HistoricalPricesButton.Label" DefaultValue="Historical Prices"/>
        <bt:String id="ClassicalTestButton.Label" DefaultValue="Classical Test"/>
        <bt:String id="HybridTestButton.Label" DefaultValue="Hybrid Test"/>
        <bt:String id="QuantumTestButton.Label" DefaultValue="Quantum Test"/>
        <bt:String id="CompareMethodsButton.Label" DefaultValue="Compare Methods"/>
        <bt:String id="ExportResultsButton.Label" DefaultValue="Export Results"/>
        <bt:String id="GenerateReportButton.Label" DefaultValue="Generate Report"/>
        <bt:String id="FunctionsHelpButton.Label" DefaultValue="Functions Help"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="NoiraTaskpaneButton.Tooltip" DefaultValue="Open the Noira AI copilot side panel"/>
        <bt:String id="AnalyticsTaskpaneButton.Tooltip" DefaultValue="Open financial analytics dashboard"/>
        <bt:String id="ImportPortfolioButton.Tooltip" DefaultValue="Import portfolio data from selected Excel range"/>
        <bt:String id="SalesforceButton.Tooltip" DefaultValue="Connect to Salesforce and import financial data"/>
        <bt:String id="HistoricalPricesButton.Tooltip" DefaultValue="Load historical price data for selected assets"/>
        <bt:String id="ClassicalTestButton.Tooltip" DefaultValue="Run classical sensitivity analysis"/>
        <bt:String id="HybridTestButton.Tooltip" DefaultValue="Run hybrid quantum-classical analysis"/>
        <bt:String id="QuantumTestButton.Tooltip" DefaultValue="Run quantum sensitivity analysis"/>
        <bt:String id="CompareMethodsButton.Tooltip" DefaultValue="Compare Classical, Hybrid, and Quantum methods"/>
        <bt:String id="ExportResultsButton.Tooltip" DefaultValue="Export analysis results to new worksheet"/>
        <bt:String id="GenerateReportButton.Tooltip" DefaultValue="Generate comprehensive analysis report"/>
        <bt:String id="FunctionsHelpButton.Tooltip" DefaultValue="See how to use Kanosym custom functions"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
